# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel
# (Project → Settings → Environment Variables). Nunca publique os valores.

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chave secreta: só no servidor (Supabase → Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp do salão (só números, com DDI) ---
NEXT_PUBLIC_WHATSAPP=5511932139081

# --- E-mails pelo Gmail (senha de app: myaccount.google.com/apppasswords) ---
GMAIL_USER=nicbeautty@gmail.com
GMAIL_APP_PASSWORD=

# --- Google Agenda (conta de serviço com acesso à agenda) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=nicbeautty@gmail.com

# --- Captcha Cloudflare Turnstile (dash.cloudflare.com → Turnstile) ---
# sem as duas, o captcha fica desligado
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Lembretes automáticos (texto aleatório longo; a Vercel usa para chamar a rotina) ---
CRON_SECRET=

# --- Opcionais ---
# lista de reserva de administradoras (só usada se a tabela "administradores" não existir)
ADMIN_EMAILS=
# ID do perfil no Google (o link também pode ser colado no painel → Avaliações)
NEXT_PUBLIC_GOOGLE_PLACE_ID=
